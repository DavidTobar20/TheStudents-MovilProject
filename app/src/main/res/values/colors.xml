<?xml version="1.0" encoding="utf-8"?>
<!--
    Estos colores NO son los tokens de la app: la paleta vive en ui/theme/Color.kt.

    El unico consumidor de este archivo es el tema XML de la ventana (themes.xml),
    que Android necesita antes de que Compose arranque para pintar el fondo del
    arranque en frio. Cada valor es un espejo de su token en Color.kt; si cambia
    alla, cambia aqui.
-->
<resources>
    <!-- Espejo de Green20 / Green80 (primary claro / oscuro) -->
    <color name="window_primary_light">#FF173531</color>
    <color name="window_primary_dark">#FFABCDC8</color>

    <!-- Espejo de Cream98 / Forest6 (background claro / oscuro) -->
    <color name="window_background_light">#FFFEF9F2</color>
    <color name="window_background_dark">#FF081614</color>

    <!-- Espejo de Green100 / Green20 (onPrimary claro / oscuro) -->
    <color name="window_on_primary_light">#FFFFFFFF</color>
    <color name="window_on_primary_dark">#FF173531</color>
</resources>
