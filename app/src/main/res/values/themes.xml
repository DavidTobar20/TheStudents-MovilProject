<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Tema de ventana. Solo cubre el arranque en frio, antes de que Compose
        instale TheStudentsTheme; a partir de ahi manda ui/theme/Theme.kt.
        Su unico trabajo real es que el fondo del arranque sea el crema de la
        marca y no un blanco o morado que produzca un destello.
    -->
    <style name="Theme.TheStudents" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/window_primary_light</item>
        <item name="colorOnPrimary">@color/window_on_primary_light</item>
        <item name="android:windowBackground">@color/window_background_light</item>

        <!-- Barras transparentes: enableEdgeToEdge() y Theme.kt controlan el resto. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>
